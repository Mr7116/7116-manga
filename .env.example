# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations / scripts)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Password for /login (admin pages: /import, /watchlist). Use a long random string.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Bearer token for machine callers (Vercel Cron, Supabase pg_cron, sync daemon).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="change-me-to-another-long-random-string"

# Public URL of the deployed site (used by `npm run cron:setup` and the sync daemon)
APP_URL="https://your-app.vercel.app"

# Optional sync tuning (defaults shown)
# SYNC_BATCH_SIZE=3          # watched manga checked per run
# SYNC_MAX_NEW_CHAPTERS=8    # new chapters downloaded per manga per run
# SYNC_TIME_BUDGET_MS=40000  # stop starting new work after this long (route limit is 60s)
